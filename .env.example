# Public values from Supabase → Project Settings → API
# Safe to use in the browser. Never put the service_role key here.
# Local: copy to .env (gitignored). Production builds also read .env.production.
VITE_SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY
# Also accepted (Next.js / publishable-key dashboard labels):
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional. Public form endpoint that accepts a JSON POST, such as a Formspree form URL.
# Leave unset until you have one. Never put a private API key here.
# VITE_CONTACT_FORM_URL=https://formspree.io/f/your-form-id
